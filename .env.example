# Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer Legacy API Keys → anon (eyJ...) if Realtime shows CHANNEL_ERROR / transport failure
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres (Supabase → Connect → Prisma)
# On Vercel you MUST use the shared pooler (IPv4). Direct db.*.supabase.co is IPv6-only and will 500.
# Copy the exact host from the dashboard (may be aws-0-… or aws-1-…).
# Username is postgres.YOUR_PROJECT_REF (not just postgres).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social login — set to "true" only after enabling the provider in Supabase Auth
# NEXT_PUBLIC_AUTH_GOOGLE=true
# NEXT_PUBLIC_AUTH_GITHUB=true
