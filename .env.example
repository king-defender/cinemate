# Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer Legacy API Keys → anon (eyJ...) if Realtime shows CHANNEL_ERROR / transport failure
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection strings (Settings → Database)
# DATABASE_URL uses the pooled connection (port 6543, ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL uses the direct connection (port 5432) for migrations
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social login — set to "true" only after enabling the provider in Supabase Auth
# NEXT_PUBLIC_AUTH_GOOGLE=true
# NEXT_PUBLIC_AUTH_GITHUB=true
